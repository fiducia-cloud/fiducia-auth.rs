watch_file .nix/flake.nix
watch_file .nix/flake.lock
use flake ./.nix

# Deliberately does NOT load secrets. Two reasons:
#
#  1. An auto-loaded secret is in the environment of *every* subprocess started
#     from this directory — package-manager install hooks, editors, agents.
#     Reach for secrets explicitly instead:
#         just env-run local cargo run
#  2. direnv's `dotenv` disagrees with dotenv libraries on quoting, and rejects
#     unquoted values containing spaces outright. `just env-run` uses one
#     consistent parser so there is nothing to reconcile.
#
# If a tool insists on a real file, materialise one with `just env-decrypt`;
# it lands in env/dec/ (gitignored, mode 0600) and the tool parses it itself.
